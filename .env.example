# Local, paper-trading starter. For Docker Compose use the two isolated files:
#   cp .env.bot.example .env.bot
#   cp .env.dashboard.example .env.dashboard
# Never put a real private key, exchange secret, or database password in Git.

DEPLOYMENT_ENV=development
BOT_MODE=paper
TRADING_PAIRS=binance:BTC/USDT

MARKET_DATA_EXCHANGE=binance
INTERVAL=15m
LOOP_SECONDS=60
CANDLE_LIMIT=200
MARKET_DATA_MAX_AGE_SECONDS=180
USE_CLOSED_CANDLES=true

MAX_POSITION_PCT=10
MAX_TOTAL_EXPOSURE_PCT=30
MAX_ORDER_NOTIONAL_USD=100
MAX_ORDER_SLIPPAGE_BPS=100
MAX_DAILY_LOSS_PCT=2
MAX_TOTAL_DRAWDOWN_PCT=10
MIN_NOTIONAL_USD=10
MAX_OPEN_POSITIONS=3

PAPER_INITIAL_CAPITAL=1000
FEE_RATE=0.001
SLIPPAGE_BPS=5

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=tradingbot
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DATABASE=trading_bot
POSTGRES_SSLMODE=prefer

LOG_LEVEL=INFO
JSON_LOGS=true
