# paper or live
BOT_MODE=paper

# venue:symbol pairs, comma separated.
# venue can be: binance, evm, or polymarket
TRADING_PAIRS=binance:BTC/USDT,evm:ETH/USDT

# Market data source, any ccxt exchange id
MARKET_DATA_EXCHANGE=binance
INTERVAL=15m
LOOP_SECONDS=60
CANDLE_LIMIT=200
QUOTE_CURRENCY=USDT
# Derive signals from closed candles rather than the currently-forming candle.
USE_CLOSED_CANDLES=true

# Strategy parameters
EMA_FAST=12
EMA_SLOW=26
RSI_PERIOD=14
ATR_PERIOD=14
STOP_LOSS_ATR_MULT=2.0
TAKE_PROFIT_ATR_MULT=3.0

# Risk parameters
MAX_POSITION_PCT=10
MAX_DAILY_LOSS_PCT=2
MAX_TOTAL_DRAWDOWN_PCT=10
MIN_NOTIONAL_USD=10
MAX_OPEN_POSITIONS=3

# Costs / paper trading
FEE_RATE=0.001
SLIPPAGE_BPS=5
PAPER_INITIAL_CAPITAL=1000

# Binance API
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# EVM / MetaMask wallet
# Use a dedicated hot wallet, not your main wallet.
EVM_PRIVATE_KEY=0x...
EVM_RPC_URL=https://eth.llamarpc.com
EVM_CHAIN_ID=1

# Uniswap V2 Router on Ethereum mainnet.
# For BSC, use PancakeSwap router and BSC tokens.
EVM_ROUTER_ADDRESS=0x7a250d5630B4cF539739dF2C5dAcb4c659F2488D

# Optional fixed gas price in Gwei. Leave empty to use network gas price.
EVM_GAS_PRICE_GWEI=

# DEX slippage tolerance in basis points. 50 = 0.5%
EVM_SLIPPAGE_BPS=50
# Safer default: approve only the amount required for the next swap.
EVM_APPROVE_MAX=false
EVM_RECEIPT_TIMEOUT_SECONDS=180

# JSON mapping from ccxt symbol to ERC20 token addresses.
# Example: Ethereum mainnet WETH / USDC
EVM_SYMBOLS={"ETH/USDT":{"base":"0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2","quote":"0xA0b86991c6218b36c1d19D4a2e9Eb0C6E3606eB48"}}

# Polymarket CLOB / MetaMask signer (Polygon)
# Symbols are aliases used in TRADING_PAIRS; each one maps to one YES or NO outcome token.
# POLYMARKET_PRIVATE_KEY must belong to a dedicated wallet/signer, not your primary wallet.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=
# Optional but recommended for gasless Deposit Wallet operations.
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=
POLYMARKET_HISTORY_INTERVAL=1d
POLYMARKET_FIDELITY_MINUTES=15
POLYMARKET_SLIPPAGE_BPS=100
POLYMARKET_MARKETS={"example-yes":{"token_id":"your_polymarket_yes_outcome_token_id"}}

# PostgreSQL state database (positions, trades, equity history, durable order intents)
# POSTGRES_DSN, when set, takes precedence over the individual POSTGRES_* fields.
POSTGRES_DSN=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=tradingbot
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=trading_bot
POSTGRES_SSLMODE=prefer

# Monitoring dashboard (username/password login)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-too
# Long random string used to sign session cookies, e.g. `openssl rand -hex 32`
DASHBOARD_SECRET_KEY=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
# Set true whenever users access the dashboard over HTTPS, including through a TLS reverse proxy.
# Keep false only for local HTTP development.
DASHBOARD_SECURE_COOKIES=false

# Optional AWS Secrets Manager
SECRET_MANAGER=
SECRET_ID=trading-bot/secrets

LOG_LEVEL=INFO
LOG_FILE=bot.log
