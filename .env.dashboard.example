# Dashboard-only configuration. Docker Compose reads this as .env.dashboard.
# Do NOT copy exchange, wallet, or Polymarket credentials into this file.

DEPLOYMENT_ENV=development
BOT_MODE=paper
TRADING_PAIRS=binance:BTC/USDT
LOOP_SECONDS=60

# Prefer a PostgreSQL role with only SELECT on positions/trades/equity_history/
# meta/orders. State schema must be initialized by the bot or migration first.
POSTGRES_DSN=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Local Compose uses `tradingbot`; production should replace this with the
# least-privilege dashboard role described in PRODUCTION.md.
POSTGRES_USER=tradingbot
POSTGRES_PASSWORD=replace-with-the-same-local-db-password
POSTGRES_DATABASE=trading_bot
POSTGRES_SSLMODE=prefer
POSTGRES_SSLROOTCERT=
POSTGRES_CONNECT_TIMEOUT_SECONDS=10

DASHBOARD_USERNAME=replace-with-a-non-default-user
DASHBOARD_PASSWORD=replace-with-at-least-16-characters
# Generate with: openssl rand -hex 32
DASHBOARD_SECRET_KEY=replace-with-at-least-32-characters
DASHBOARD_SECURE_COOKIES=false
DASHBOARD_HEARTBEAT_STALE_SECONDS=180
DASHBOARD_LOGIN_MAX_ATTEMPTS=5
DASHBOARD_LOGIN_WINDOW_SECONDS=300
DASHBOARD_LOGIN_LOCKOUT_SECONDS=900
# Set only to the exact number of TLS reverse proxies in front of Gunicorn.
TRUSTED_PROXY_COUNT=0

LOG_LEVEL=INFO
JSON_LOGS=true
LOG_FILE=
