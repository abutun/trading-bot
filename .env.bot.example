# Bot-only secrets and runtime settings. Docker Compose reads this as .env.bot.
# Keep this file out of version control after copying it.

# Use production only with externally managed PostgreSQL TLS and HTTPS dashboard.
DEPLOYMENT_ENV=development
BOT_MODE=paper
# Required exactly when BOT_MODE=live:
LIVE_TRADING_CONFIRMATION=

# Add only assets whose symbols are valid on MARKET_DATA_EXCHANGE. For an EVM
# pair, EVM_SYMBOLS must map that same local symbol to verified token contracts.
TRADING_PAIRS=binance:BTC/USDT
MARKET_DATA_EXCHANGE=binance
INTERVAL=15m
LOOP_SECONDS=60
CANDLE_LIMIT=200
QUOTE_CURRENCY=USDT
USE_CLOSED_CANDLES=true
MARKET_DATA_MAX_AGE_SECONDS=180
MAX_CONSECUTIVE_FAILURES=3
ORDER_COOLDOWN_SECONDS=30

EMA_FAST=12
EMA_SLOW=26
RSI_PERIOD=14
ATR_PERIOD=14
STOP_LOSS_ATR_MULT=2.0
TAKE_PROFIT_ATR_MULT=3.0

MAX_POSITION_PCT=10
MAX_TOTAL_EXPOSURE_PCT=30
MAX_ORDER_NOTIONAL_USD=100
MAX_ORDER_SLIPPAGE_BPS=100
MAX_DAILY_LOSS_PCT=2
MAX_TOTAL_DRAWDOWN_PCT=10
MIN_NOTIONAL_USD=10
MAX_OPEN_POSITIONS=3

PAPER_INITIAL_CAPITAL=1000
FEE_RATE=0.001
SLIPPAGE_BPS=5

# Binance Spot. Live mode requires BINANCE_ORDER_MODE=ioc_limit.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
BINANCE_ORDER_MODE=ioc_limit

# EVM / exported dedicated MetaMask signing account. Do not use a primary wallet.
EVM_PRIVATE_KEY=
EVM_RPC_URL=
EVM_RPC_TIMEOUT_SECONDS=15
EVM_CHAIN_ID=1
EVM_ROUTER_ADDRESS=
EVM_GAS_PRICE_GWEI=
EVM_MAX_GAS_PRICE_GWEI=100
EVM_MAX_GAS_LIMIT=600000
EVM_MIN_CONFIRMATIONS=1
EVM_SLIPPAGE_BPS=50
EVM_APPROVE_MAX=false
EVM_RECEIPT_TIMEOUT_SECONDS=180
EVM_SYMBOLS={}

# Polymarket CLOB V2 (Polygon, chain 137). Use an outcome token ID, never a
# human-readable market slug. Supply all three API values, or explicitly allow
# one-time derivation from the dedicated signer.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_DERIVE_API_CREDENTIALS=false
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_HISTORY_INTERVAL=1d
POLYMARKET_FIDELITY_MINUTES=15
POLYMARKET_SLIPPAGE_BPS=100
POLYMARKET_MARKETS={}

# Bot write role. In production use a TLS-protected external PostgreSQL DSN or
# POSTGRES_SSLMODE=verify-full plus POSTGRES_SSLROOTCERT.
POSTGRES_DSN=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=tradingbot
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DATABASE=trading_bot
POSTGRES_SSLMODE=prefer
POSTGRES_SSLROOTCERT=
POSTGRES_CONNECT_TIMEOUT_SECONDS=10

LOG_LEVEL=INFO
JSON_LOGS=true
LOG_FILE=
